---
import "@/styles/global.css";
interface Props {
  skillId: string;
  color?: string;
  text?: string;
}

const {
  skillId,
  color = "bg-[#6957ff]",
  text = "text-[#ffffff]",
} = Astro.props;
---

<span
  class=`text-xs font-medium ${color} ${text} rounded-full py-1 px-3 align-middle whitespace-nowrap`
>
  {skillId}
</span>

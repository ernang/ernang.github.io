---
const { href } = Astro.props;
---

<a
  href={href}
  class="w-fit inline-flex items-center gap-2 py-2.5 px-5 rounded-full text-sm font-medium decoration-0 border-2 border-solid border-gray-700/25
  bg-[#232323] cursor-pointer transition-[transform,border-color,opacity] duration-900 ease hover:-translate-y-0.5 hover:border-gray-400/55"
>
  <slot />
</a>

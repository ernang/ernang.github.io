---
import "@/styles/global.css";
import GitHub from "@/components/icons/GitHub.astro";
import NextJS from "@/components/icons/NextJS.astro";
import Tailwind from "@/components/icons/Tailwind.astro";
import Expo from "@/components/icons/Expo.astro";
import ReactNative from "@/components/icons/ReactNative.astro";
import Java from "@/components/icons/Java.astro";
import Cpp from "@/components/icons/Cpp.astro";
import JavaScript from "@/components/icons/JavaScript.astro";
import Shell from "@/components/icons/Shell.astro";
import HTML from "@/components/icons/HTML.astro";
import CSS from "@/components/icons/CSS.astro";
import LinkButton from "@/components/LinkButton.astro";
import SectionHeading from "@/components/SectionHeading.astro";

const TAGS = {
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  EXPO: {
    name: "Expo",
    class: "bg-slate-500/50 text-white",
    icon: Expo,
  },
  REACT_NATIVE: {
    name: "React Native",
    class: "bg-[#0b83a3] text-black",
    icon: ReactNative,
  },
  JAVA: {
    name: "Java",
    class: "bg-[#00216e] text-white",
    icon: Java,
  },
  CPP: {
    name: "C++",
    class: "bg-[#4986d1] text-white",
    icon: Cpp,
  },
  JAVASCRIPT: {
    name: "JavaScript",
    class: "bg-yellow-500/80 text-black",
    icon: JavaScript,
  },
  SHELL: {
    name: "Shell",
    class: "bg-black text-white",
    icon: Shell,
  },
  HTML: {
    name: "HTML",
    class: "bg-[#e34c26] text-white",
    icon: HTML,
  },
  CSS: {
    name: "CSS",
    class: "bg-[#264de4] text-white",
    icon: CSS,
  },
};
import { getLangFromUrl, getTranslation } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);

const t = getTranslation(lang);

const projectsTitle = t.titles.projects;
const viewGithub = t.titles.viewGithub;
const projectsList = t.projects;

const getTagInfo = (tagValue: string) => {
  const normalizedTagValue = tagValue.replace(
    /^TAGS\./,
    "",
  ) as keyof typeof TAGS;
  return TAGS[normalizedTagValue];
};
---

<div
  class="mx-auto w-full max-w-300 grid-cols-1 gap-4 px-4 md:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-0"
>
  <SectionHeading title={projectsTitle} color="#6957ff" id="projects" />
  <div class="grid gap-4 grid-cols-1 lg:grid-cols-3 md:grid-cols-2">
    {
      projectsList.map((project) => (
        <div
          class="relative bg-[#1c1c1c] border-2 border-gray-700/80 rounded-3xl p-[clamp(20px,2.2vw,28px)] flex flex-col box-border overflow-hidden shadow
          transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)]
          after:absolute after:inset-0 after:pointer-events-none after:rounded-[inherit] after:opacity-0 after:bg-[radial-gradient(420px_circle_at_50%_0%,rgba(124,92,255,0.16),transparent_70%)] after:transition-opacity after:duration-350 after:ease-in-out hover:after:opacity-100
          hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gray-950"
        >
          <div class="relative rounded-2xl overflow-hidden aspect-video bg-black mb-4">
            <div
              class="size-full bg-center bg-no-repeat aspect-video bg-cover"
              style={`background-image: url('${project.image}');`}
            />
          </div>
          <div class="pt-0 pl-1.5 pr-1.5 gap-y-2 flex min-w-0 flex-col flex-1 tracking-tight">
            <h3 class="m-0 text-[1.05rem] font-semibold">{project.title}</h3>
            <p class="mt-2 mr-0 text-sm text-[#b3b1ab] leading-6 flex-1 min-w-0">
              {project.description}
            </p>
            <ul class="mt-2.5 flex flex-wrap gap-2 mb-2">
              {project.tags.map((tag) => {
                const tagInfo = getTagInfo(tag.value);
                return (
                  <span
                    class={`flex min-w-0 flex-row gap-x-0.5 rounded-full text-2xs items-center md:text-xs ${tagInfo.class} py-1 px-2 whitespace-nowrap`}
                  >
                    <tagInfo.icon class="size-4" />
                    {tagInfo.name}
                  </span>
                );
              })}
            </ul>
            <LinkButton href={project.github} class="mt-4 self-start">
              <GitHub class="size-4" />
              {viewGithub}
            </LinkButton>
          </div>
        </div>
      ))
    }
  </div>
</div>

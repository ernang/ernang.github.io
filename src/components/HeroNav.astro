---
import "@/styles/global.css";

import { getLangFromUrl, getTranslation } from "@/i18n/utils";
import { languages, defaultLang } from "@/i18n/ui";
import LanguageSwitcher from "@/components/LanguageSwitcher.astro";
import { Image } from "astro:assets";
import faviconImage from "@pub/favicon.svg";

const lang = getLangFromUrl(Astro.url);

const t = getTranslation(lang);

const heroNav = t.heroNav;
const languageTitle = t.titles.language;
---

<nav
  class="z-20 mb-4.5 mt-12.5 mx-auto w-full max-w-300 grid-cols-1 px-4 md:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-0 transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gray-950 hover:rounded-full"
>
  <section
    class="flex items-center justify-between rounded-4xl px-3 py-4 border border-[#3a3a3a] bg-[#1d1d1d] shadow-[0_24px_50px_rgba(0,0,0,0.2)]"
  >
    <span class="flex flex-row items-center gap-2 text-base text-white">
      <Image
        class="h-7 w-7 rounded-sm"
        src={faviconImage}
        alt="Ernest Anguera"
        loading="eager"
        fetchpriority="high"
      />
      Ernest Anguera
    </span>

    <ul
      class="justify-between space-x-5 hidden lg:flex lg:flex-row lg:justify-between"
    >
      {
        heroNav.map((item) => (
          <li>
            <a
              class="px-2 py-3 rounded-lg transition-colors hover:text-stone-100 hover:bg-neutral-800"
              href={item.href}
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
    <LanguageSwitcher />

    <details class="relative lg:hidden">
      <summary
        class="inline-flex items-center gap-2 rounded-full border border-[#6957ff]/20 bg-[#111111] px-4 py-2.5 text-sm font-medium text-white shadow-[0_18px_40px_rgba(0,0,0,0.25)] ring-1 ring-[#6957ff]/10 transition hover:border-[#6957ff]/60 hover:bg-[#161616] focus:outline-none focus:ring-2 focus:ring-[#6957ff]/20 cursor-pointer"
      >
        <span class="flex h-4 w-4 flex-col justify-between">
          <span class="block h-0.5 w-4 rounded-full bg-current"></span>
          <span class="block h-0.5 w-4 rounded-full bg-current"></span>
          <span class="block h-0.5 w-4 rounded-full bg-current"></span>
        </span>
        <span class="uppercase tracking-[0.24em] text-xs text-slate-300"
          >menu</span
        >
      </summary>
      <div
        class="absolute right-0 top-full z-20 mt-2 min-w-55 overflow-hidden rounded-[1.75rem] border border-[#3a3a3a] bg-[#111111]/95 p-2 shadow-[0_24px_70px_rgba(0,0,0,0.35)] backdrop-blur-sm"
      >
        <ul class="space-y-1">
          {
            heroNav.map((item) => (
              <li>
                <a
                  class="block rounded-2xl px-4 py-3 text-sm text-white/90 transition hover:text-white hover:bg-[#1f1f1f]"
                  href={item.href}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
        <div class="mt-3 border-t border-[#3a3a3a] pt-3">
          <details
            class="rounded-3xl border border-[#2f2f2f] bg-[#111111] hover:overflow-x-hidden"
          >
            <summary
              class="flex items-center justify-between gap-3 px-4 py-3 text-sm font-medium text-white cursor-pointer transition hover:bg-[#161616]"
            >
              <span class="uppercase tracking-[0.28em] text-slate-500"
                >{languageTitle}</span
              >
              <span
                class="rounded-2xl border border-[#3a3a3a] bg-[#151515] px-3 py-2 text-sm text-white"
              >
                {languages[lang]}
              </span>
            </summary>
            <div
              class="max-h-72 overflow-y-auto overflow-x-hidden pb-2 pt-2 px-1 rounded-2xl"
            >
              <div class="grid gap-2">
                {
                  Object.entries(languages).map(([code, label]) => {
                    const href = code === defaultLang ? "/" : `/${code}/`;
                    return (
                      <a
                        class={`block rounded-2xl px-4 py-3 text-sm font-medium transition ${code === lang ? "bg-[#6957ff] text-white" : "bg-[#151515] text-slate-300 hover:bg-[#1f1f1f] hover:text-white"}`}
                        href={href}
                        aria-current={code === lang ? "page" : undefined}
                      >
                        {label}
                      </a>
                    );
                  })
                }
              </div>
            </div>
          </details>
        </div>
      </div>
    </details>
  </section>
</nav>

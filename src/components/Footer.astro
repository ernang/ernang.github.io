---
import "@/styles/global.css";

import { getLangFromUrl, getTranslation } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);

const t = getTranslation(lang);

const footer = t.footer;
---

<footer class="pt-8 pb-4 px-2">
  <div class="mb-4 border-t border-[#b3b1ab]/20"></div>

  <div
    class="flex flex-col items-center gap-2 text-xs text-[#b3b1ab] md:flex-row md:items-center md:justify-between"
  >
    <span class="lg:ml-4">
      © {new Date().getFullYear()} Ernest Anguera
    </span>

    <span> {footer.text} </span>

    <div class="flex gap-4 lg:mr-4">
      <a class="hover:underline" href="mailto:nestanguera@gmail.com">Gmail</a>
      <a class="hover:underline" href="https://github.com/ernang">GitHub</a>
      <a class="hover:underline" href="https://linkedin.com/in/ernestanguera"
        >LinkedIn</a
      >
      <a class="hover:underline" href="https://ernang.github.io">CV</a>
    </div>
  </div>
</footer>

---
import "@/styles/global.css";
import SectionHeading from "@/components/SectionHeading.astro";
import { getLangFromUrl, getTranslation } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);

const t = getTranslation(lang);

const experience = t.experience;
const experienceTitle = t.titles.experience;
---

<div
  class="mx-auto w-full max-w-300 grid-cols-1 gap-4 px-4 md:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-0"
>
  <SectionHeading title={experienceTitle} color="#00c2a8" id="experience" />

  <div class="flex flex-col flex-1">
    {
      experience.map((experienceCard) => (
        <div class="relative bg-[#1c1c1c] mb-3.5 border-2 border-gray-700/80 rounded-3xl flex flex-row items-center gap-5 flex-wrap p-4 box-border overflow-hidden shadow transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gray-950">
          <div
            class={`size-14 rounded-xl grid place-items-center font-extrabold text-sm tracking-tight text-[#0e0e0d] ${experienceCard.color}`}
          >
            {experienceCard.mark}
          </div>

          <div class="flex-1 min-w-52">
            <div class="m-0 text-lg font-semibold tracking-tight">
              {experienceCard.role}
            </div>
            <div class="mt-1 mr-0 ml-0 text-sm text-[#7e7c76] tabular-nums">
              {experienceCard.company} · {experienceCard.period}
            </div>

            <div class="mt-2 mr-0 ml-0 text-sm leading-6 text-[#b3b1ab] max-w-prose">
              {experienceCard.detail}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>

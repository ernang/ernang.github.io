---
import "@/styles/global.css";
import SectionHeading from "@/components/SectionHeading.astro";
import { getLangFromUrl, getTranslation } from "@/i18n/utils";

const lang = getLangFromUrl(Astro.url);

const t = getTranslation(lang);

const contactTitle = t.titles.contact;
const contact = t.contact;

const profile = t.profile;

const socials = t.socials;
---

<div
  class="mx-auto w-full max-w-300 grid-cols-1 gap-4 px-4 md:px-6 lg:grid-cols-[minmax(0,1fr)_300px] lg:px-0"
>
  <SectionHeading title={contactTitle} color="#ff5c8a" id="contacto" />
  <div
    class="flex min-h-50 items-center text-center px-6 py-[clamp(32px,5vw,56px)] bg-[linear-gradient(140deg,var(--surface)_0%,var(--surface-2)_100%)] flex-col rounded-3xl border border-[#3a3a3a] bg-[#1d1d1d] p-6 shadow md:p-7 transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gray-950"
  >
    <h2 class="m-0 text-[clamp(2rem,5vw,3rem)] font-bold tracking-[-0.04em]">
      {contact.text1}
      <span
        class="bg-[linear-gradient(90deg,#9b5cff,#ff5c8a)] bg-clip-text text-transparent"
        >{contact.text2}</span
      >
      {contact.text3}
    </h2>
    <p class="mt-3.5 ml-0 mr-0 mb-7 text-[#b3b1ab] max-w-prose leading-6">
      {contact.text4}
    </p>
    <div class="mt-2.5 flex flex-wrap gap-2.5 justify-center">
      <a
        class="inline-flex items-center gap-2 py-2.5 px-5 rounded-full text-sm font-medium no-underline border border-solid border-stone-800 text-[#f5f4f1] bg-[linear-gradient(90deg,#ff5c8a,#9b5cff)] cursor-pointer transition-all duration-400 ease-[cubic-bezier(0.22,1,0.36,1)] hover:-translate-y-0.5 hover:shadow-lg hover:shadow-gray-900 hover:bg-[linear-gradient(90deg,#9b5cff,#ff5c8a)] hover:text-shadow-white"
        href={`mailto:${profile.email}`}
      >
        {profile.email}
      </a>
      {
        socials.map((social) => (
          <a
            class={`${social.style}`}
            href={social.href}
            target="_blank"
            rel="noreferrer"
          >
            {social.label}
          </a>
        ))
      }
    </div>
  </div>
</div>
